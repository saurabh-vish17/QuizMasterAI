# ============================================================
# QuizMaster AI — Environment Variables Template
# ============================================================
# 1. Copy this file:  copy .env.example .env
# 2. Fill in your actual values inside .env
# 3. NEVER commit .env to version control
# ============================================================

# Google Gemini API Key
# Obtain your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifier (e.g. gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Maximum request timeout in seconds
AI_REQUEST_TIMEOUT=15
